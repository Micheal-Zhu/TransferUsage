<Window x:Class="BalanceDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Balance Dock"
        Width="400" Height="182" MinWidth="400" MinHeight="142" MaxHeight="592"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Grid>
        <Border x:Name="Surface" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
            <Grid x:Name="ShellLayout" Width="730" HorizontalAlignment="Right">
                <Grid x:Name="AddPanel" Width="330" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="AddPanelTransform" X="20" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0" />
                    <Grid Grid.Row="0" Margin="22,24,22,0">
                        <TextBlock x:Name="UrlPlaceholder" Text="粘贴余额页面 URL" FontSize="15"
                                   Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Top" IsHitTestVisible="False" />
                        <TextBox x:Name="UrlInput" Style="{StaticResource UrlTextBoxStyle}" VerticalAlignment="Top"
                                 KeyDown="UrlInput_KeyDown" TextChanged="UrlInput_TextChanged" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="20,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AddStatus" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ConnectButton" Grid.Column="1" Style="{StaticResource RoundCommandButtonStyle}"
                                Click="ConnectButton_Click" ToolTip="确认并连接" IsEnabled="False">
                            <Canvas Width="28" Height="28">
                                <Line X1="14" Y1="20" X2="14" Y2="9" Stroke="{DynamicResource CommandForegroundBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="9.5" Y1="13.5" X2="14" Y2="9" Stroke="{DynamicResource CommandForegroundBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="18.5" Y1="13.5" X2="14" Y2="9" Stroke="{DynamicResource CommandForegroundBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="CollapseCover" Width="330" HorizontalAlignment="Left"
                      Background="Black" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

                <Grid x:Name="MainPanel" Width="400" HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,5,12,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="API 余额" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="HeaderStatus" Text="余额" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="AddToggleButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="AddToggleButton_Click" ToolTip="添加中转站">
                            <Canvas Width="20" Height="20">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="AddIconRotation" CenterX="10" CenterY="10" />
                                </Canvas.RenderTransform>
                                <Line X1="5" Y1="10" X2="15" Y2="10" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="10" Y1="5" X2="10" Y2="15" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,2,24,28">
                            <Ellipse Width="18" Height="18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" Opacity="0.22" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无站点" FontSize="13" Foreground="{DynamicResource PlaceholderBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>

                        <ListBox x:Name="StationList" ItemsSource="{Binding DisplayedStations}" Padding="0,0,0,10"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="76" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,6,12,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{Binding StatusBackground}" ToolTip="{Binding StatusText}">
                                                <TextBlock Text="{Binding StatusGlyph}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding BalanceDisplay}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <Button Grid.Column="3" Width="30" Height="30" Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                                                    Click="StationMenuButton_Click" ToolTip="站点操作" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondaryBrush}" Margin="1" />
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondaryBrush}" Margin="1" />
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondaryBrush}" Margin="1" />
                                                </StackPanel>
                                            </Button>
                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="4" Margin="0,6,8,0"
                                                  ToolTip="{Binding ProgressToolTip}">
                                                <Border Background="{DynamicResource TrackBrush}" CornerRadius="2" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Background="Transparent" BorderThickness="0">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid ClipToBounds="True">
                                                                <Border x:Name="PART_Track" CornerRadius="2" />
                                                                <Border x:Name="PART_Indicator" Background="{Binding ProgressColor}" CornerRadius="2" HorizontalAlignment="Left" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </Grid>
                                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding UpdatedLabel}" FontSize="10.5" Foreground="{DynamicResource PlaceholderBrush}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CacheHitDisplay}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"
                                                               Opacity="0.78" ToolTip="{Binding CacheHitToolTip}" />
                                                    <TextBlock Text="{Binding UsageDisplay}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="SessionBrowser" Width="1" Height="1" Visibility="Collapsed"
                      IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Grid>
</Window>
